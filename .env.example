# Neon pooled URL used by the running Next.js application.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Neon direct URL used only by Drizzle Kit migrations and database checks.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-HOST.REGION.aws.neon.tech/DATABASE?sslmode=require
